# Local-dev .env template. Copy to .env and fill in.
# In production these go in the Render dashboard, NOT in this file.

# HTTP Basic Auth on BizCore itself.
ADMIN_PASSWORD=
# ADMIN_USER=admin              # optional, defaults to "admin"

# Where to proxy /api/* — your team-calendar deploy (no trailing slash).
# Local dev: http://localhost:3000  (or wherever team-calendar runs)
# Prod:      https://signarama-temecula-calendar.onrender.com
TEAM_CALENDAR_URL=http://localhost:3000

# Service-account login on team-calendar — must be role=admin there.
# Server logs in on startup, holds the session cookie, attaches it to
# proxied requests. Refreshed on 401.
TC_USER_EMAIL=
TC_USER_PASSWORD=

# All upstream API keys (Anthropic, Corebridge, BankSync, Gusto, etc.)
# stay in team-calendar's env, not here. BizCore is a thin reader.
